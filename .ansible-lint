---
# Third-party collections are excluded: they are installed dependencies, not ours.
exclude_paths:
  - ansible_collections/community
  - ansible_collections/containers
  - ansible_collections/kubernetes
  - ansible_collections/*.info
  - ansible_collections/ansible
# The per-cluster roles (install_config, cluster_install, verify) set
# cluster_name/cluster_kubeconfig etc. via set_fact deliberately: the
# paths taxonomy (group_vars/all/paths.yml) derives install_dir,
# cluster_domain and kubeconfig paths from cluster_name, so the shared
# names are the interface — not role-local knobs.
skip_list:
  - var-naming[no-role-prefix]
