# Managed by shanemcd.dr_lab.loadbalancer.
global
  log stdout format raw local0
  maxconn 20000

defaults
  mode tcp
  log global
  option tcplog
  timeout connect 10s
  timeout client 60m
  timeout server 60m

{% for c in compact_clusters %}
{% for port in [6443, 22623, 80, 443] %}
listen cluster_{{ c.name | replace('-', '_') }}_{{ port }}
  bind {{ c.api_vip }}:{{ port }}
{% if port in [6443, 22623] and c.name not in lb_completed_clusters %}
  server bootstrap {{ c.bootstrap[0].ip }}:{{ port }} check inter 2s fall 3 rise 2
{% endif %}
{% for m in c.masters %}
  server {{ m.name }} {{ m.ip }}:{{ port }} check inter 2s fall 3 rise 2
{% endfor %}

{% endfor %}
{% endfor %}
