[Unit]
Description=dr-lab HAProxy (API/ingress VIPs for compact clusters)
Wants=network-online.target
After=network-online.target

[Service]
ExecStartPre=/bin/rm -f /run/dr-lab-lb.pid /run/dr-lab-lb.pid.lock
ExecStart=/usr/bin/podman run --rm --name dr-lab-lb \
  --network host \
  --conmon-pidfile /run/dr-lab-lb.pid \
  -v /etc/dr-lab/haproxy.cfg:/etc/haproxy/haproxy.cfg:ro,Z \
  localhost/dr-lab/haproxy:latest
ExecStop=/usr/bin/podman stop --time 30 dr-lab-lb
Restart=on-failure
RestartSec=5
Type=forking
PIDFile=/run/dr-lab-lb.pid

[Install]
WantedBy=multi-user.target
