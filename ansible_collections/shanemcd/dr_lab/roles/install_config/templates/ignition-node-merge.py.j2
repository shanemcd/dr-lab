#!/usr/bin/env python3
# Managed by shanemcd.dr_lab.install_config — do not edit.
# Assembles per-node / per-cluster ignition configs for fw_cfg delivery.
#
# Modes:
#   node    — merge node-specific static network + name resolution into a
#             base ignition (the SNO BiP master ignition). The base config
#             is preserved verbatim except for same-path file entries,
#             which are replaced (ignition merge semantics, deterministic).
#   wrapper — build a compact-cluster master live-wrapper: embeds the
#             installer's master.ign and a coreos-installer install-to-disk
#             unit. The live boot installs the real master pointer config
#             to /dev/vda (--copy-network keeps DHCP/default networking)
#             and reboots into the real first boot.
import base64
import json
import os
import sys


def data_url(text):
    return "data:text/plain;base64," + base64.b64encode(
        text.encode()
    ).decode()


def content_aware_write(out_path, new_bytes):
    try:
        with open(out_path, "rb") as f:
            if f.read() == new_bytes:
                print("UNCHANGED")
                raise SystemExit(0)
    except FileNotFoundError:
        pass
    tmp_path = out_path + ".tmp"
    with open(tmp_path, "wb") as f:
        f.write(new_bytes)
    os.replace(tmp_path, out_path)
    print("MERGED")


def wrapper_mode(master_path, out_path):
    with open(master_path) as f:
        master_text = f.read()
    unit = """[Unit]
Description=dr-lab compact master install to disk
After=network-online.target
Wants=network-online.target
Before=zincati.service

[Service]
Type=oneshot
ExecStart=/usr/bin/coreos-installer install {{ bip_installation_disk }} --copy-network --ignition-file /opt/dr-lab/master.ign
ExecStartPost=/usr/bin/systemctl --no-block reboot
StandardOutput=kmsg+console
StandardError=kmsg+console

[Install]
WantedBy=multi-user.target
"""
    config = {
        "ignition": {"version": "3.4.0"},
        "storage": {
            "files": [
                {
                    "path": "/opt/dr-lab/master.ign",
                    "mode": 420,
                    "overwrite": True,
                    "contents": {"source": data_url(master_text)},
                }
            ]
        },
        "systemd": {
            "units": [
                {
                    "name": "dr-lab-install-to-disk.service",
                    "enabled": True,
                    "contents": unit,
                }
            ]
        },
    }
    content_aware_write(
        out_path, json.dumps(config, separators=(",", ":")).encode()
    )


def node_mode(argv):
    if len(argv) != 11:
        sys.stderr.write(
            "usage: ignition-node-merge.py node <base.ign> <out.ign> "
            "<node_name> <node_ip> <prefix_len> <gateway> <node_mac> "
            "<dns_csv> <hosts_snippet>\n"
            "       ignition-node-merge.py wrapper <master.ign> <out.ign>\n"
        )
        sys.exit(2)
    (
        base_path,
        out_path,
        node_name,
        node_ip,
        prefix_len,
        gateway,
        node_mac,
        dns_csv,
        hosts_snippet_path,
    ) = argv[2:]
    with open(base_path) as f:
        config = json.load(f)

    storage = config.setdefault("storage", {})
    files = storage.setdefault("files", [])

    def upsert_file(path, mode, text):
        entry = {
            "path": path,
            "mode": mode,
            "overwrite": True,
            "contents": {"source": data_url(text)},
        }
        for i, existing in enumerate(files):
            if existing.get("path") == path:
                files[i] = entry
                return
        files.append(entry)

    # Node hostname (kubelet node name comes from this).
    upsert_file("/etc/hostname", 420, node_name + "\n")

    # Static name resolution: the fleet-wide lab hosts block plus the
    # node's own entry. The lab resolver (dnsmasq on the gateway) serves
    # these names at initramfs fetch time; the baked /etc/hosts is
    # belt-and-braces.
    with open(hosts_snippet_path) as f:
        hosts_text = f.read().rstrip("\n")
    hosts_text += "\n{} {}.{{ base_domain }} {}\n".format(
        node_ip, node_name, node_name
    )
    upsert_file("/etc/hosts", 420, hosts_text + "\n")

    # Static network (MAC-bound NM keyfile; one NIC per VM). The lab
    # resolver (the gateway) serves cluster names AND forwards internet
    # names — ignition merge fetches need it before /etc/hosts is applied.
    dns = ";".join(dns_csv.split(",")) + ";"
    nm_keyfile = (
        "[connection]\n"
        "id={}\n"
        "type=ethernet\n"
        "autoconnect=true\n"
        "\n"
        "[ethernet]\n"
        "mac-address={}\n"
        "\n"
        "[ipv4]\n"
        "method=manual\n"
        "address1={},{}\n"
        "dns={}\n"
        "\n"
        "[ipv6]\n"
        "method=disabled\n"
    ).format(
        "{{ install_config_nm_connection_id }}",
        node_mac,
        "{}/{}".format(node_ip, prefix_len),
        gateway,
        dns,
    )
    upsert_file(
        "/etc/NetworkManager/system-connections/"
        "{{ install_config_nm_connection_file }}",
        384,
        nm_keyfile,
    )
    content_aware_write(
        out_path, json.dumps(config, separators=(",", ":")).encode()
    )


if __name__ == "__main__":
    if len(sys.argv) >= 2 and sys.argv[1] == "wrapper":
        if len(sys.argv) != 4:
            sys.stderr.write(
                "usage: ignition-node-merge.py wrapper <master.ign> "
                "<out.ign>\n"
            )
            sys.exit(2)
        wrapper_mode(sys.argv[2], sys.argv[3])
    else:
        node_mode(sys.argv)
