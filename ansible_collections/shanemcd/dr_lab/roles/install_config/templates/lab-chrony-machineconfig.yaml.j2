# Host chrony relays its synchronized upstream time to the isolated lab network.
apiVersion: machineconfiguration.openshift.io/v1
kind: MachineConfig
metadata:
  name: 99-dr-lab-master-chrony
  labels:
    machineconfiguration.openshift.io/role: master
spec:
  config:
    ignition:
      version: 3.2.0
    storage:
      files:
        - path: /etc/chrony.conf
          mode: 420
          overwrite: true
          contents:
            source: "data:text/plain;charset=utf-8;base64,{{ lab_chrony_config | b64encode }}"
